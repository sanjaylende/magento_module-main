<?xml version="1.0"?>
<!--
    Menu: Flipick > Flipick Video Generator (the page that frames the adapter UI). The extension has no settings screen; the
    adapter addresses are constants in Model/Endpoints.php. menu.xml actions are validated against ^[A-Za-z0-9/_-]+$, so they must be
    admin routes, never the adapter's own URL. The product grid page (flipick_videogenerator/index/index) still exists but has
    no menu entry. The item id "video_generator_billing" is kept (the page marks it active in Controller/Adminhtml/Index/Billing.php).
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Backend:etc/menu.xsd">
    <menu>
        <add id="Flipick_VideoGenerator::video_generator" title="Flipick" translate="title" module="Flipick_VideoGenerator" sortOrder="100" resource="Flipick_VideoGenerator::video_generator"/>
        <add id="Flipick_VideoGenerator::video_generator_billing" title="Flipick Video Generator" translate="title" module="Flipick_VideoGenerator" sortOrder="20" parent="Flipick_VideoGenerator::video_generator" action="flipick_videogenerator/index/billing" resource="Flipick_VideoGenerator::video_generator"/>
    </menu>
</config>
