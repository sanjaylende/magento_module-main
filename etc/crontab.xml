<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Rotates and zips var/log/flipick_videogenerator.log every day at 00:05 (store timezone). -->
        <job name="flipick_videogenerator_rotate_logs" instance="Flipick\VideoGenerator\Cron\RotateLogs" method="execute">
            <schedule>5 0 * * *</schedule>
        </job>
    </group>
</config>
